NODE_ENV=development
PORT=5001
HOST=0.0.0.0
LAN_IP=192.168.1.16

# Use `memory` for local dev without Docker/MongoDB (data lost on restart!).
# Use a real URI to keep accounts and tickets:
# Local: mongodb://localhost:27017/tvk_support
# Production (Atlas): mongodb+srv://user:pass@cluster.mongodb.net/tvk_support
MONGODB_URI=mongodb://localhost:27017/tvk_support

# Bootstrapped on startup (admin app login).
DEFAULT_ADMIN_EMAIL=tvksuppourt@gmail.com
DEFAULT_ADMIN_PASSWORD=tvksuppourt
DEFAULT_ADMIN_NAME=TVK Support

JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Flutter web uses random localhost ports; development also allows any local/LAN origin.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:5001,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5001,http://10.153.168.151:3000,http://10.153.168.151:5173,http://10.153.168.151:5174,http://10.153.168.151:8080,http://10.153.168.151:5001,http://192.168.1.16:3000,http://192.168.1.16:5173,http://192.168.1.16:5174,http://192.168.1.16:8080,http://192.168.1.16:5001,http://10.0.2.2:5001

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

SWAGGER_SERVER_URL=http://192.168.1.16:5001

# Web Push (open-source web-push — generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=BEwXiEBN33QeVqq7dgARWHi_QxY9N2d6lxot9g7-tvh_0410roDX6M_91QteNOreJZdrQB2UVK0xFpn4N_G27Y8
VAPID_PRIVATE_KEY=ilMukCDg48JphHxOsqzvcLDIRGn_7EMQzuYK7CoulBg
VAPID_SUBJECT=mailto:support@tvk.com

# SMTP configuration (for password reset OTP)
# Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Local dev without SMTP: OTP is printed in the server terminal (NODE_ENV=development does this automatically).
# You can also set SMTP_LOG_OTP=true when NODE_ENV=production on a test server.
SMTP_LOG_OTP=false

# Optional public URL included in staff invitation emails (?token= is appended).
# Use the LAN IP so a phone on the same WiFi can open the link.
INVITE_ACCEPT_URL=http://192.168.1.16:5001/api/v1/user-management/invitations/accept

# Free cloud AI (Groq free tier — no card / no local models).
# Create key: https://console.groq.com/keys  then paste as OPENAI_API_KEY or GROQ_API_KEY
OPENAI_API_KEY=
GROQ_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant

# Vercel cron (/api/cron/overdue) — required in production. Vercel sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Optional FCM (JSON string of the Firebase service account).
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Production (Vercel) ---
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/tvk_support?retryWrites=true&w=majority
# JWT_ACCESS_SECRET=generate-a-long-random-string
# JWT_REFRESH_SECRET=generate-a-different-long-random-string
# CORS_ORIGIN=https://your-admin-web.example,https://your-user-web.example
# SWAGGER_SERVER_URL=https://tvkssbe.vercel.app
# INVITE_ACCEPT_URL=https://tvkssbe.vercel.app/api/v1/user-management/invitations/accept
# CRON_SECRET=generate-a-long-random-string
