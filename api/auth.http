### Auth — Register, Login, Refresh, Profile
@baseUrl = http://localhost:5001
@apiUrl = {{baseUrl}}/api/v1

@userEmail = squallhari+0@gmail.com
@userPassword = password123
@adminEmail = squallhari+1@gmail.com
@adminPassword = password123
@agentEmail = agent@tvk.com
@agentPassword = password123
@resetOtp = 123456
@newPassword = newpassword123

###############################################
# Setup — run once to create test accounts
###############################################

### Register mobile user (returns tokens on first sign-up; re-run says account exists — use Login)
# @name registerUser
POST {{apiUrl}}/auth/register
Content-Type: application/json

{
  "name": "TVK User",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

###

@userAccessToken = {{registerUser.response.body.data.accessToken}}
@userRefreshToken = {{registerUser.response.body.data.refreshToken}}
@userId = {{registerUser.response.body.data.user.id}}

### Register admin
# @name registerAdmin
POST {{apiUrl}}/auth/register
Content-Type: application/json

{
  "name": "TVK Admin",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "role": "admin"
}

### Register support agent
# @name registerAgent
POST {{apiUrl}}/auth/register
Content-Type: application/json

{
  "name": "TVK Agent",
  "email": "{{agentEmail}}",
  "password": "{{agentPassword}}",
  "role": "support_agent"
}

###############################################
# Login — tokens captured for other requests
###############################################

### Login as user
# @name loginUser
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

###

@userAccessToken = {{loginUser.response.body.data.accessToken}}
@userRefreshToken = {{loginUser.response.body.data.refreshToken}}
@userId = {{loginUser.response.body.data.user.id}}

### Login as admin
# @name loginAdmin
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###

@adminAccessToken = {{loginAdmin.response.body.data.accessToken}}
@adminRefreshToken = {{loginAdmin.response.body.data.refreshToken}}
@adminId = {{loginAdmin.response.body.data.user.id}}

### Login as support agent
# @name loginAgent
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{agentEmail}}",
  "password": "{{agentPassword}}"
}

###

@agentAccessToken = {{loginAgent.response.body.data.accessToken}}
@agentId = {{loginAgent.response.body.data.user.id}}

###############################################
# Token & profile
###############################################

### Refresh access token
# @name refreshToken
POST {{apiUrl}}/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "{{userRefreshToken}}"
}

###

@newAccessToken = {{refreshToken.response.body.data.accessToken}}

### Get profile (user)
GET {{apiUrl}}/auth/profile
Authorization: Bearer {{userAccessToken}}

### Get profile (admin)
GET {{apiUrl}}/auth/profile
Authorization: Bearer {{adminAccessToken}}

### Invalid login (expect 401)
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "wrong-password"
}

###############################################
# Forgot password (OTP via SMTP email)
#
# IMPORTANT:
# - Account must exist (register/login first). With MONGODB_URI=memory, users are lost on server restart.
# - In development, OTP is also printed in the backend terminal: [DEV] Password reset OTP for ...
# - Check spam/promotions if email is not in inbox.
# - Ensure .env has real SMTP_* values (not .env.example placeholders).
#
# Flow:
# 1. Register or login the account first
# 2. Run "Request password reset OTP"
# 3. Set @resetOtp from email (or backend terminal in dev)
# 4. Run "Verify OTP"
# 5. Run "Reset password with OTP"
# 6. Run "Login with new password"
###############################################

### Request password reset OTP (user)
# @name forgotPasswordUser
POST {{apiUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "{{userEmail}}"
}

### Request password reset OTP (admin)
# @name forgotPasswordAdmin
POST {{apiUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "{{adminEmail}}"
}

### Verify OTP (user)
# @name verifyOtpUser
POST {{apiUrl}}/auth/verify-otp
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "otp": "{{resetOtp}}"
}

### Reset password with OTP (user)
# Replace @resetOtp with the 6-digit code from your email
# @name resetPasswordUser
POST {{apiUrl}}/auth/reset-password
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "otp": "{{resetOtp}}",
  "password": "{{newPassword}}"
}

### Reset password with OTP (admin)
# @name resetPasswordAdmin
POST {{apiUrl}}/auth/reset-password
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "otp": "{{resetOtp}}",
  "password": "{{newPassword}}"
}

### Login with new password (after reset)
# @name loginAfterReset
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "password": "{{newPassword}}"
}

### Invalid OTP (expect 400)
POST {{apiUrl}}/auth/reset-password
Content-Type: application/json

{
  "email": "{{userEmail}}",
  "otp": "000000",
  "password": "{{newPassword}}"
}

### Forgot password — unknown email (still returns 200, no email sent)
POST {{apiUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "notregistered@example.com"
}
